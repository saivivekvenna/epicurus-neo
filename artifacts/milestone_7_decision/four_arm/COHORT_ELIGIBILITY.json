{
  "policy": "three-level-benchmark-1.0.0",
  "levels": [
    {
      "level": 1,
      "name": "reachability",
      "description": "raw variants/WES/RNA/HLA through peptide generation, with stage-loss attribution (recognized mutations lost at generation vs rankable vs top-k)",
      "requirements": [
        "lossless_generation",
        "measured_labels",
        "pvac_candidates"
      ]
    },
    {
      "level": 2,
      "name": "conditional_ranking",
      "description": "ranking only among candidates actually generated/rankable, interpreted strictly within this cohort's own assay/denominator (never pooled)",
      "requirements": [
        "genuine_prime",
        "measured_labels",
        "pvac_candidates"
      ]
    },
    {
      "level": 3,
      "name": "end_to_end_patient_utility",
      "description": "PRIMARY north star: recognized mutations in the final top-20 from common raw inputs, vs a standard pVAC-style pipeline + genuine PRIME",
      "requirements": [
        "genuine_prime",
        "lossless_generation",
        "measured_labels",
        "pvac_candidates"
      ]
    }
  ],
  "no_pooling": "These cohorts serve DIFFERENT tasks over DIFFERENT denominators (broad-somatic Gartner, prefiltered IMPROVE, presentation/T-cell multimer, external CheckMate, end-to-end Sid) and are NEVER pooled into one headline metric. A single cross-cohort reranker number would be a category error. Each level and each cohort is reported and interpreted on its own.",
  "four_arm_harness_role": "reusable infrastructure; produces an end-to-end headline ONLY for Level-3-eligible cohorts (currently osteosarc_sid, post-hoc).",
